  "faq": {
    "title": "Sık sorulanlar",
    "items": [
      {
        "question": "Ücretsiz keşif yapıyor musunuz?",
        "answer": "Evet. İstanbul ve yakın çevresi için keşif planlaması yapıyoruz. Kesin kapsam ve uygunluk telefon görüşmesinde netleştirilir."
      },
      {
        "question": "Anahtar teslim hizmete neler dahil?",
        "answer": "Projenin ihtiyacına göre kaba yapı, tesisat koordinasyonu, sıva, boya, zemin, seramik ve dekorasyon işleri tek plan altında yönetilebilir."
      },
